# Firebase Console → Project settings → General → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Where property photos are kept:
#   firestore = FREE. Photos are compressed in the browser and saved in Firestore (default, max 4 per listing)
#   storage   = Firebase Storage (needs the Blaze pay-as-you-go plan, max 6 per listing)
VITE_IMAGE_STORAGE=firestore

# Optional but recommended for production: reCAPTCHA v3 site key for Firebase App Check
VITE_RECAPTCHA_SITE_KEY=
